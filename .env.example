# ═══════════════════════════════════════════════════════════════════════════════
# ZyxxyzWhymzykalWunderland — local environment template
# Copy this file to .env and fill in any values marked REQUIRED.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Shared secret (used by TypeScript API, Python API, and .NET API) ──────────
# REQUIRED — must be at least 32 random characters
JWT_SECRET=change-me-to-something-random-32-chars-min

# ── Anonymail ─────────────────────────────────────────────────────────────────
# Domain that appears in generated addresses e.g. swift.fox.3a4b@anonymail.local
ANONYMAIL_DOMAIN=anonymail.local
# Mailbox lifetime in milliseconds (default: 1 hour)
MAILBOX_TTL_MS=3600000
# Maximum concurrent mailboxes (0 = unlimited)
MAX_MAILBOXES=0
# Outbound SMTP relay — leave blank to disable real email delivery (log-only)
SMTP_OUT_HOST=
SMTP_OUT_PORT=587
SMTP_OUT_USER=
SMTP_OUT_PASS=

# ── The Locator ───────────────────────────────────────────────────────────────
# Optional — without a token the worker falls back to free Nominatim geocoding
MAPBOX_TOKEN=
# Optional — Census API key for higher rate limits on population data
CENSUS_API_KEY=
