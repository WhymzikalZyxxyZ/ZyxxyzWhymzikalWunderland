# ── HTTP server ───────────────────────────────────────────────────────────────
PORT=3000

# Domain that appears in generated addresses  e.g.  swift.fox.3a4b@YOUR_DOMAIN
DOMAIN=anonymail.local

# Mailbox lifetime in ms (default 1 hour)
MAILBOX_TTL_MS=3600000

# ── HTTPS (leave blank for plain HTTP in development) ─────────────────────────
TLS_CERT=/path/to/cert.pem
TLS_KEY=/path/to/key.pem

# ── Inbound SMTP ──────────────────────────────────────────────────────────────
SMTP_PORT=2525
# Set SMTP_SECURE=1 to accept TLS-wrapped connections on SMTP_PORT
SMTP_SECURE=

# ── Outbound SMTP relay (leave blank to log-only / no real delivery) ──────────
SMTP_OUT_HOST=smtp.example.com
SMTP_OUT_PORT=587
SMTP_OUT_USER=user@example.com
SMTP_OUT_PASS=secret
