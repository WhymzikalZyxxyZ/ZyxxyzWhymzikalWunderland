<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ApplicationId>xyz.zyxwonderland.maui</ApplicationId>
    <ApplicationTitle>Zyxxyz</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>ZyxxyzMaui</RootNamespace>
    <!--
      CI on Linux can only install the maui-android workload (maui-ios /
      maui-maccatalyst error out at `dotnet workload install` — "isn't
      supported on this platform" — so a normal unfiltered restore of the
      full TargetFrameworks list always fails there). Passing
      -p:TargetFramework(s)=net9.0-android from the command line to scope
      restore down doesn't work either: that's a *global* MSBuild property,
      and global properties unconditionally override a ProjectReference's
      own file-level TargetFramework during restore — it silently broke
      ../../shared/ZyxxyzShared.csproj's plain net9.0 restore every time,
      regardless of SetTargetFramework metadata (that's build-time-only).
      ZyxxyzCiAndroidOnly is a property name nothing else in the solution
      reads, so passing -p:ZyxxyzCiAndroidOnly=true from CI can't leak into
      and override any other project's own TargetFramework.
    -->
    <TargetFrameworks Condition="'$(ZyxxyzCiAndroidOnly)' == 'true'">net9.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(ZyxxyzCiAndroidOnly)' != 'true'">net9.0-android;net9.0-ios;net9.0-maccatalyst;net9.0-windows10.0.19041.0</TargetFrameworks>
    <!--
      .NET-for-Android always builds every supported ABI (arm64-v8a,
      x86_64, ...) regardless of Debug/Release unless RuntimeIdentifiers is
      pinned, and that requires a RID-qualified restore entry for
      ../../shared/ZyxxyzShared.csproj (a plain library with no native code
      and no RID needs of its own) or the build fails with NETSDK1047.

      Setting RuntimeIdentifiers here on the entry project does NOT, on its
      own, make restore produce that RID-qualified entry for the reference
      — confirmed directly in CI: restore succeeded, but the resulting
      assets file still had no 'net9.0/android-arm64' target for
      ZyxxyzShared. NuGet only creates a RID-qualified restore-graph entry
      for a given ProjectReference when *that reference's own* evaluated
      properties include a RuntimeIdentifier — the same mechanism that
      makes SetTargetFramework below actually work (confirmed working in
      an earlier CI run). So RuntimeIdentifier also has to be set as
      per-reference Properties metadata on the ProjectReference itself, not
      inferred from this property. Kept here too since the actual Android
      build machinery still reads it from the entry project.
    -->
    <RuntimeIdentifiers Condition="'$(ZyxxyzCiAndroidOnly)' == 'true'">android-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Maui" Version="9.*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.*" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Properties="RuntimeIdentifier=android-arm64" only applies to CI's
      Android-only build — it must not leak into normal multi-target dev
      builds (net9.0-ios/maccatalyst/windows), where forcing an Android RID
      onto this reference would be nonsensical. Split into two mutually
      exclusive items on the same Condition as everything else here rather
      than trying to make one item's metadata itself conditional.
    -->
    <ProjectReference Condition="'$(ZyxxyzCiAndroidOnly)' == 'true'" Include="..\..\shared\ZyxxyzShared.csproj" SetTargetFramework="TargetFramework=net9.0" Properties="RuntimeIdentifier=android-arm64" />
    <ProjectReference Condition="'$(ZyxxyzCiAndroidOnly)' != 'true'" Include="..\..\shared\ZyxxyzShared.csproj" SetTargetFramework="TargetFramework=net9.0" />
  </ItemGroup>
  <ItemGroup>
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1a1a2e" />
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1a1a2e" />
  </ItemGroup>
</Project>
